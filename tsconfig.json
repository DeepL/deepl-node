{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "baseUrl": "src",
        "declaration": true,
        "esModuleInterop": true,
        "lib": ["es2022"],
        "moduleResolution": "node",
        "noFallthroughCasesInSwitch": true,
        "paths": { "deepl-node": ["."] },
        "skipLibCheck": true,
        "strict": true,
        "types": ["node", "jest"],
        "module": "commonjs",
        "outDir": "dist",
        "target": "es2022",
        "useDefineForClassFields": false
    },
    "compileOnSave": false,
    "exclude": ["tests", "dist", "node_modules"],
    "include": ["src"]
}
